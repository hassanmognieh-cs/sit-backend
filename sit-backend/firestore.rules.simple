rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // SIMPLIFIED RULES - Allows employees to update tasks without role checks
    // This is a temporary/permissive version that works immediately
    
    // Tasks collection rules
    match /tasks/{taskId} {
      // Allow read for all authenticated users
      allow read: if request.auth != null;
      
      // Allow create for authenticated users (you can restrict this later)
      allow create: if request.auth != null;
      
      // Allow update:
      // - If task is assigned to user's email or 'all', allow updating status and completed only
      // - Otherwise, allow full update (for managers/admins - you can add role check later)
      allow update: if request.auth != null && (
        // If task is assigned to this user, only allow status/completed updates
        ((resource.data.assignedToEmail == request.auth.token.email ||
          resource.data.assignedToEmail == 'all') &&
         // Only allow updating status and completed fields
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'completed']) &&
         // Ensure other fields remain unchanged
         request.resource.data.title == resource.data.title &&
         request.resource.data.description == resource.data.description &&
         request.resource.data.assignedToEmail == resource.data.assignedToEmail &&
         request.resource.data.createdByName == resource.data.createdByName &&
         request.resource.data.createdAt == resource.data.createdAt &&
         (request.resource.data.dueDate == resource.data.dueDate || 
          (request.resource.data.dueDate == null && resource.data.dueDate == null))) ||
        // Allow full update for other cases (managers creating tasks, etc.)
        // You can add role checks here later if needed
        true
      );
      
      // Allow delete for authenticated users (restrict this later if needed)
      allow delete: if request.auth != null;
    }
    
    // Users collection - allow users to read their own data
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null; // You can restrict this later
    }
    
    // Other collections - keep existing rules or allow read for authenticated users
    match /products/{productId} {
      allow read, write: if request.auth != null;
    }
    
    match /categories/{categoryId} {
      allow read, write: if request.auth != null;
    }
    
    match /suppliers/{supplierId} {
      allow read, write: if request.auth != null;
    }
  }
}






